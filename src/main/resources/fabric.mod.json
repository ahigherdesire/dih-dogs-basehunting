{
  "schemaVersion": 1,
  "id": "dogs-basehunting",
  "version": "${version}",
  "name": "Dogs BaseHunting & Misc Tools",
  "description": "Base hunting for DIH: SeedCrackerX seed cracking, bedrock/texture coordinate finders, stash/tunnel/chunk finders, DonutSMP AH tools and misc modules.",
  "authors": [
    "doghero002-cmd",
    "KaptainWutax",
    "19MisterX98"
  ],
  "license": "GPL-3.0-only",
  "icon": "assets/seedcrackerx/icon.png",
  "custom": {
    "modmenu": {
      "parent": {
        "id": "dih"
      }
    },
    "dih:color": "80,200,120"
  },
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.autism.seedcracker.SeedcrackerInit"
    ],
    "dih": [
      "com.autism.seedcracker.SeedcrackerAddon"
    ]
  },
  "mixins": [
    "seedcracker.mixins.json"
  ],
  "accessWidener": "seedcrackerx.aw",
  "depends": {
    "java": ">=25",
    "minecraft": "${mc_compat}",
    "fabricloader": ">=0.19.3",
    "fabric-api": ">=${fabric_api_version}",
    "dih": "${dih_api_version}"
  },
  "contact": {
    "homepage": "https://dih.lxysg.com/addons#dogs-basehunting",
    "sources": "https://github.com/ahigherdesire/dih-dogs-basehunting",
    "issues": "https://github.com/ahigherdesire/dih-dogs-basehunting/issues"
  }
}
